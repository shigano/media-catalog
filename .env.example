# Base de données (MySQL, comme le portail — peut être la même instance,
# avec un nom de base différent)
DATABASE_URL="mysql://user:password@localhost:3306/media_catalog"

# Clé API TMDB (gratuite : https://www.themoviedb.org/settings/api)
TMDB_API_KEY=""

# Un ou plusieurs dossiers à scanner, séparés par des virgules. Chemin vu
# depuis CE serveur (le VPS) — si tes fichiers sont sur un NAS monté en
# sshfs comme évoqué plus tôt dans le projet, utilise le point de montage
# local (ex: /mnt/nas/films).
LIBRARY_PATHS="/mnt/nas/films,/mnt/nas/series"

# Connexion brute (hors Prisma) vers la base MySQL du portail d'abonnement
# — sert à vérifier les identifiants et le statut d'abonnement à la
# connexion. Même serveur MySQL que ce projet, juste une autre base.
ACCOUNT_PORTAL_DATABASE_URL="mysql://user:password@localhost:3306/account_portal"

# Secret de signature des jetons de session media-catalog — génère une
# valeur aléatoire, différente de celle du portail (ce sont deux
# applications séparées). Exemple : openssl rand -hex 32
JWT_SECRET=""
